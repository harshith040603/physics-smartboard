---
interface Props { experiment: 'projectile' | 'piston' | 'atom' }
const { experiment } = Astro.props;
---
<svg viewBox="0 0 360 156" fill="none" aria-hidden="true" focusable="false" class="experiment-art">
  {experiment === 'projectile' && (
    <>
      <path d="M39 130V23M26 116H334" stroke="#193B78" stroke-opacity=".3" stroke-width="1.5"/>
      <path d="M54 115Q177 -51 300 115" stroke="#1644C2" stroke-width="3.5" stroke-dasharray="4 7" stroke-linecap="round"/>
      <path d="M54 115Q107 43 160 34" stroke="#1644C2" stroke-width="4" stroke-linecap="round"/>
      <path d="M160 34V115M54 133H300M54 128v10m246-10v10" stroke="#1644C2" stroke-opacity=".45" stroke-dasharray="3 4"/>
      <path d="M44 114l19-17 8 9-12 11H44z" fill="#18336D"/>
      <circle cx="160" cy="34" r="15" fill="#F6BF43" stroke="#193B78" stroke-width="2.5"/>
      <circle cx="156" cy="29" r="4" fill="#FFF0BB"/>
      <circle cx="300" cy="115" r="5" fill="#1644C2"/>
      <text x="177" y="146" text-anchor="middle" fill="#193B78" font-size="10" font-family="monospace">RANGE</text>
      <text x="317" y="108" fill="#193B78" font-size="12" font-family="monospace">x</text>
    </>
  )}
  {experiment === 'piston' && (
    <>
      <path d="M77 37v91h96V37" stroke="#6B2C28" stroke-width="3" stroke-linejoin="round"/>
      <path d="M79 68h92v58H79z" fill="#FFD08D"/>
      <path d="M81 109c19-7 32 5 46-1s30-5 42-1v18H81z" fill="#F88A66" opacity=".65"/>
      <path d="M75 64h100v11H75z" fill="#9C3C37" stroke="#6B2C28" stroke-width="2"/>
      <path d="M120 32h10v32h-10z" fill="#E79175" stroke="#6B2C28" stroke-width="2"/>
      <rect x="103" y="24" width="44" height="12" rx="4" fill="#9C3C37"/>
      <path d="M95 90l3 1m26-1 5 3m16 17 5-1m-41 7 4-1m42-23 4 2" stroke="#9C3C37" stroke-width="3.5" stroke-linecap="round"/>
      <path d="M225 119V42m0 77h93" stroke="#6B2C28" stroke-opacity=".5" stroke-width="1.5"/>
      <path d="M237 57Q260 94 306 100v19h-69z" fill="#F7856F" opacity=".6"/>
      <path d="M237 57Q260 94 306 100" stroke="#9C3C37" stroke-width="3" stroke-linecap="round"/>
      <circle cx="237" cy="57" r="4" fill="#9C3C37"/>
      <circle cx="306" cy="100" r="4" fill="#9C3C37"/>
      <text x="214" y="42" fill="#6B2C28" font-size="11" font-family="monospace">P</text>
      <text x="320" y="124" fill="#6B2C28" font-size="11" font-family="monospace">V</text>
    </>
  )}
  {experiment === 'atom' && (
    <>
      <circle cx="179" cy="78" r="64" stroke="#58409B" stroke-opacity=".3" stroke-dasharray="2 5"/>
      <circle cx="179" cy="78" r="47" stroke="#58409B" stroke-opacity=".3"/>
      <ellipse cx="179" cy="78" rx="99" ry="31" transform="rotate(-23 179 78)" stroke="#6743C8" stroke-width="2.5"/>
      <ellipse cx="179" cy="78" rx="99" ry="31" transform="rotate(23 179 78)" stroke="#6743C8" stroke-width="2.5"/>
      <ellipse cx="179" cy="78" rx="72" ry="26" transform="rotate(90 179 78)" stroke="#6743C8" stroke-width="2.5"/>
      <circle cx="179" cy="78" r="23" fill="#7954D3" stroke="#49317D" stroke-width="2"/>
      <circle cx="173" cy="71" r="6" fill="#AF97F0"/>
      <circle cx="254" cy="45" r="9" fill="#FFF0B5" stroke="#49317D" stroke-width="2"/>
      <circle cx="104" cy="45" r="8" fill="#B9F0DB" stroke="#49317D" stroke-width="2"/>
      <circle cx="179" cy="143" r="7" fill="#B9F0DB" stroke="#49317D" stroke-width="2"/>
      <path d="M267 47h38m-27 56h27" stroke="#58409B" stroke-opacity=".5" stroke-dasharray="3 4"/>
      <text x="309" y="51" fill="#49317D" font-size="12" font-family="monospace">e−</text>
      <text x="309" y="107" fill="#49317D" font-size="12" font-family="monospace">Z</text>
    </>
  )}
</svg>
