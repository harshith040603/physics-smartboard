<div class="home-visual" data-physics-scene>
  <div class="scene-topline">
    <span class="scene-live-dot"></span>
    <span>Motion lab</span>
    <span class="scene-topline-id">3D sandbox</span>
  </div>
  <div class="scene-stage" role="img" aria-label="Illustration of an orbiting body">
    <canvas class="scene-canvas" aria-hidden="true"></canvas>
    <svg class="scene-fallback" viewBox="0 0 360 230" fill="none" aria-hidden="true">
      <circle cx="180" cy="115" r="93" stroke="#8B9FD0" stroke-opacity=".25" stroke-dasharray="3 6"/>
      <ellipse cx="180" cy="115" rx="120" ry="42" transform="rotate(-27 180 115)" stroke="#C4D4FF" stroke-width="2"/>
      <ellipse cx="180" cy="115" rx="120" ry="42" transform="rotate(26 180 115)" stroke="#7694F2" stroke-width="2"/>
      <circle cx="180" cy="115" r="37" fill="#3566EF"/>
      <circle cx="168" cy="102" r="13" fill="#789CFF"/>
      <circle cx="251" cy="54" r="13" fill="#F7C657"/>
      <circle cx="99" cy="80" r="9" fill="#A5F1D2"/>
    </svg>
    <span class="scene-axis" aria-hidden="true"><b>+</b> FIELD VIEW</span>
  </div>
  <div class="scene-controls" aria-label="Physics scene">
    <div class="scene-modes">
      <button type="button" class="active" data-scene="orbit" data-caption="Orbit · Follow two bodies around a shared centre." aria-pressed="true">Orbit</button>
      <button type="button" data-scene="wave" data-caption="Wave · Watch a disturbance travel along the row." aria-pressed="false">Wave</button>
      <button type="button" data-scene="pendulum" data-caption="Pendulum · Follow the bob as it swings past equilibrium." aria-pressed="false">Pendulum</button>
    </div>
    <button type="button" class="scene-pause" aria-label="Pause 3D animation" aria-pressed="false">Ⅱ</button>
  </div>
  <p class="scene-caption" aria-live="polite">Orbit · Follow two bodies around a shared centre.</p>
</div>
<script>import '../scripts/physics-scene';</script>
