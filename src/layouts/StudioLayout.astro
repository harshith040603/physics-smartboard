---
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/brand.css';

interface Props {
  title: string;
  chapterChip?: string;
}
const { title, chapterChip } = Astro.props;
const path = Astro.url.pathname;
const isHome = path === '/';
const isLibrary = ['/library', '/notes', '/worksheets'].some(route => path.startsWith(route));
const isPractice = path.startsWith('/jee-pyqs');
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light only">
<title>{title}</title>
<link rel="icon" type="image/png" href="/brand/nine-mark.png">
</head>
<body>
<a class="skip-link" href="#main-content">Skip to content</a>
<div class="wrap">
  <header class="topbar">
    <a class="brand-logo" href="/" aria-label="Nine Education home">
      <img src="/brand/nine-logo-long.png" width="2024" height="320" alt="Nine Education" fetchpriority="high" />
    </a>
    <nav class="site-nav" aria-label="Main navigation">
      <a href="/#chapters" aria-current={!isHome && !isLibrary && !isPractice ? 'page' : undefined}>Chapters</a>
      <a href="/library" aria-current={isLibrary ? 'page' : undefined}>Student Library</a>
      <a href="/jee-pyqs" aria-current={isPractice ? 'page' : undefined}>JEE Practice</a>
    </nav>
    <button class="fs-btn" id="fsBtn" onclick="toggleFS()" title="Toggle fullscreen" aria-label="Toggle fullscreen">
      <svg id="fsIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3"/>
      </svg>
    </button>
  </header>
  <div class="page-context"><span class="context-dot" aria-hidden="true"></span>{chapterChip ?? 'Class 11 · Physics'}<span class="context-end">LEARN · EXPLORE · PRACTISE</span></div>
  <main id="main-content"><slot /></main>

</div>

<footer class="site-footer">
  <div class="footer-inner">
    <a href="/" class="footer-logo" aria-label="Nine Education home"><img src="/brand/nine-logo-long.png" width="2024" height="320" alt="Nine Education" loading="lazy" /></a>
    <p>Physics with Harshith<span>Class 11 · JEE</span></p>
    <nav aria-label="Study resources"><a href="/notes">Notes</a><a href="/worksheets">Assignments</a><a href="/library">Student Library</a></nav>
  </div>
  <div class="footer-bottom">Nine Education <span>Keep asking. Keep learning.</span></div>
</footer>

<script is:inline src="/js/studio-core.js"></script>
<slot name="scripts" />
</body>
</html>
