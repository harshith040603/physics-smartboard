---
import StudioLayout from '../layouts/StudioLayout.astro';
import { chapters } from '../data/chapters';
---
<StudioLayout title="Nine Education - Physics with Harshith" chapterChip="Class 11 · Physics">
  <section class="screen active">
    <div class="hero">
      <h1>Physics with <span class="accent">Harshith</span></h1>
      <p>Your one stop for physics - interactives for the smartboard, chapter notes, and worksheets, all in one place.</p>
    </div>
    <div class="grid">
      {chapters.map((ch) =>
        ch.status === 'ready' ? (
          <a class="tile" href={`/${ch.slug}`} style="text-decoration:none;color:inherit;">
            <div class="tile-num">{ch.num}</div>
            <div class="tile-icon ic-build">
              <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
            </div>
            <h3>{ch.title}<span class="accent">{ch.titleAccent}</span></h3>
            <p>{ch.blurb}</p>
            <span class="tile-go">{ch.activities} activities - Open ›</span>
          </a>
        ) : (
          <div class="tile tile-soon" aria-disabled="true">
            <div class="tile-num">{ch.num}</div>
            <div class="tile-icon ic-build" style="opacity:.45;">
              <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
            </div>
            <h3 style="opacity:.55;">{ch.title}<span class="accent">{ch.titleAccent}</span></h3>
            <p style="opacity:.55;">{ch.blurb}</p>
            <span class="tile-go" style="opacity:.5;">Coming soon</span>
          </div>
        )
      )}
    </div>

    <h2 class="section-head">Study <span class="accent">Material</span></h2>
    <div class="grid">
      <a class="tile" href="/notes" style="text-decoration:none;color:inherit;">
        <div class="tile-icon ic-sheet">
          <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg>
        </div>
        <h3>Class <span class="accent">Notes</span></h3>
        <p>Scanned chapter notes in neat handwriting - download and print anytime.</p>
        <span class="tile-go">Open ›</span>
      </a>
      <a class="tile" href="/worksheets" style="text-decoration:none;color:inherit;">
        <div class="tile-icon ic-vec">
          <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
        </div>
        <h3>Work<span class="accent">sheets</span></h3>
        <p>Practice worksheets for every chapter - solve along, then check in class.</p>
        <span class="tile-go">Open ›</span>
      </a>
    </div>
  </section>
</StudioLayout>

<style>
  .tile-soon { cursor: default; }
  .tile-soon:hover { transform: none; }
  .section-head {
    font-family: 'Bricolage Grotesque';
    font-weight: 800;
    font-size: clamp(24px, 3vw, 34px);
    color: var(--nine-navy);
    letter-spacing: -0.8px;
    margin: 44px 0 20px;
  }
  .section-head .accent { color: var(--nine-accent); }
</style>
