---
import StudioLayout from '../layouts/StudioLayout.astro';
import { chapters } from '../data/chapters';
import '../styles/home.css';
import PhysicsScene from '../components/PhysicsScene.astro';
const summaries: Record<string, string> = {
  'units-and-dimensions': 'Measurements, dimensional formulas and experimental errors.',
  'kinematics': 'Projectiles, motion graphs and relative motion.',
  'chemistry': 'The periodic table, shielding and atomic size.',
  'thermometry': 'Temperature scales, thermal expansion and calibration.',
  'heat-transfer': 'Conduction, convection, radiation and cooling.',
  'kinetic-theory': 'Gas laws, molecular motion and degrees of freedom.',
  'thermodynamics': 'Heat, work, internal energy and gas processes.',
};
---
<StudioLayout title="Nine Education - Physics with Harshith" chapterChip="Class 11 · Physics">
  <section class="screen active">
    <div class="home-hero">
      <div class="home-intro">
        <p class="home-eyebrow">NINE EDUCATION · CLASS 11 · JEE</p>
        <h1>PHYSICS WITH<br /><span>HARSHITH</span></h1>
        <p class="home-description">Build your understanding, one concept at a time. Explore lessons, see physics in motion, and put it into practice.</p>
        <div class="home-actions">
          <a class="home-primary" href="/library">Browse student library <span aria-hidden="true">↗</span></a>
          <a class="home-secondary" href="#chapters">Explore chapters <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <PhysicsScene />
    </div>

    <div class="home-learning-strip" aria-label="Ways to learn">
      <div><span>01</span><p><strong>Learn the concept</strong>Clear lessons and student notes.</p></div>
      <div><span>02</span><p><strong>See it in motion</strong>Interactive physics, at your pace.</p></div>
      <div><span>03</span><p><strong>Put it into practice</strong>Assignments and JEE questions.</p></div>
    </div>

    <section id="chapters" class="home-section" aria-labelledby="chapters-title">
      <div class="home-section-head"><div><p class="home-eyebrow">THE CLASSROOM</p><h2 id="chapters-title">CHOOSE A CHAPTER</h2></div><span>{chapters.filter(ch => ch.status === 'ready').length} chapters to explore</span></div>
      <div class="home-chapters">
        {chapters.map(ch => ch.status === 'ready' ? (
          <a class="chapter-card" href={`/${ch.slug}`}>
            <div class="chapter-card-top"><span class="chapter-disc">{ch.num}</span><span class="chapter-arrow" aria-hidden="true">↗</span></div>
            <h3>{ch.title}{ch.titleAccent}</h3>
            <p>{summaries[ch.slug] ?? ch.blurb}</p>
            <div class="chapter-card-bottom"><span>{ch.activities} activities</span><span>Explore chapter</span></div>
          </a>
        ) : (
          <div class="chapter-card chapter-soon"><span class="chapter-disc">{ch.num}</span><h3>{ch.title}{ch.titleAccent}</h3><p>Coming soon</p></div>
        ))}
      </div>
    </section>

    <section class="home-section home-resources" aria-labelledby="resources-title">
      <div class="home-section-head"><div><p class="home-eyebrow">YOUR STUDY DESK</p><h2 id="resources-title">READY FOR REVISION</h2></div><a href="/library">All resources ↗</a></div>
      <div class="home-resource-grid">
        <a href="/notes"><span class="resource-code">01 / READ</span><h3>Student notes</h3><p>Chapter notes and reference sheets to revisit a concept.</p><span class="resource-link">Open notes ↗</span></a>
        <a href="/worksheets"><span class="resource-code">02 / SOLVE</span><h3>Assignments</h3><p>Download a practice sheet and work through it at your pace.</p><span class="resource-link">Find an assignment ↗</span></a>
        <a href="/jee-pyqs"><span class="resource-code">03 / CHECK</span><h3>JEE Main PYQs</h3><p>Solve previous-year questions, then check your answer.</p><span class="resource-link">Start practising ↗</span></a>
      </div>
    </section>
  </section>
</StudioLayout>
