---
import StudioLayout from '../../layouts/StudioLayout.astro';
import { PYQS, SECTIONS } from '../../data/pyq-projectile-motion';
import '../../styles/pyq.css';

/* only offer a chip for a sub-topic that actually has questions in the bank */
const usedSections = Object.entries(SECTIONS).filter(
  ([key]) => PYQS.some((qn) => qn.sec === key)
);
---
<StudioLayout title="Projectile Motion PYQs - Physics with Harshith" chapterChip="JEE Main · PYQs">
  <section class="screen active">
    <div class="scr-head">
      <a class="back-btn" href="/jee-pyqs" style="text-decoration:none;">‹ JEE PYQs</a>
      <div>
        <div class="scr-title">Projectile <span class="res-accent">Motion</span> · PYQs</div>
        <div class="scr-sub">{PYQS.length} JEE Main previous-year questions. Solve first, then Check answer.</div>
      </div>
    </div>

    <div class="pyq-bar">
      <div class="pyq-chips">
        <button class="pyq-chip active" data-sec="ALL">All {PYQS.length}</button>
        {usedSections.map(([key, name]) => (
          <button class="pyq-chip" data-sec={key}>{key} · {name}</button>
        ))}
      </div>
      <button id="pyqRevealAll" class="pyq-allbtn">Reveal all answers</button>
    </div>
    <div class="pyq-count"><span id="pyqCount"></span></div>

    <div class="pyq-list">
      {PYQS.map((qn) => (
        <article class="pyq-card" data-sec={qn.sec}>
          <div class="pyq-top">
            <span class="pyq-id">Q{qn.id}</span>
            {qn.source && <span class="pyq-src">{qn.source}</span>}
            <span class="pyq-secname">{SECTIONS[qn.sec]}</span>
          </div>

          <p class="pyq-q">{qn.q}</p>

          {qn.table && (
            <table class="pyq-table">
              <tbody>
                {qn.table.left.map((row, i) => (
                  <tr>
                    <td>{row}</td>
                    <td>{qn.table!.right[i]}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}

          {qn.options && (
            <div class="pyq-opts">
              {qn.options.map((opt) => (
                <button class="pyq-opt" type="button" data-correct={opt.startsWith(qn.answer) ? 'true' : undefined}>
                  <span class="pyq-opt-mark"></span>
                  <span class="pyq-opt-text">{opt}</span>
                </button>
              ))}
            </div>
          )}

          <button class="pyq-reveal">Check answer</button>

          <div class="pyq-answer">
            <div class="pyq-ans-line"><span class="pyq-ans-label">Answer</span> {qn.answer}</div>
            <div class="pyq-sol">{qn.solution}</div>
          </div>
        </article>
      ))}
    </div>
  </section>
</StudioLayout>

<script>
  import { pyqViewerInit } from '../../scripts/pyq-viewer';
  pyqViewerInit();
</script>
