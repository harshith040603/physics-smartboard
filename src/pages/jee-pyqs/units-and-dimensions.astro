---
import StudioLayout from '../../layouts/StudioLayout.astro';
import { PYQS, SECTIONS } from '../../data/pyq-units-dimensions';
---
<StudioLayout title="Units & Dimensions PYQs - Physics with Harshith" chapterChip="JEE Main · PYQs">
  <section class="screen active">
    <div class="scr-head">
      <a class="back-btn" href="/jee-pyqs" style="text-decoration:none;">‹ JEE PYQs</a>
      <div>
        <div class="scr-title">Units & <span class="res-accent">Dimensions</span> · PYQs</div>
        <div class="scr-sub">{PYQS.length} JEE Main previous-year questions. Solve first, then Check answer.</div>
      </div>
    </div>

    <div class="pyq-bar">
      <div class="pyq-chips">
        <button class="pyq-chip active" data-sec="ALL">All {PYQS.length}</button>
        {Object.entries(SECTIONS).map(([key, name]) => (
          <button class="pyq-chip" data-sec={key}>{key} · {name}</button>
        ))}
      </div>
      <button id="pyqRevealAll" class="pyq-allbtn">Reveal all answers</button>
    </div>
    <div class="pyq-count"><span id="pyqCount"></span></div>

    <div class="pyq-list">
      {PYQS.map((qn) => (
        <article class="pyq-card" data-sec={qn.sec}>
          <div class="pyq-top">
            <span class="pyq-id">Q{qn.id}</span>
            <span class="pyq-src">{qn.source}</span>
            <span class="pyq-secname">{SECTIONS[qn.sec]}</span>
          </div>

          <p class="pyq-q">{qn.q}</p>

          {qn.table && (
            <table class="pyq-table">
              <tbody>
                {qn.table.left.map((row, i) => (
                  <tr>
                    <td>{row}</td>
                    <td>{qn.table!.right[i]}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}

          {qn.options && (
            <ul class="pyq-opts">
              {qn.options.map((opt) => <li>{opt}</li>)}
            </ul>
          )}

          <button class="pyq-reveal">Check answer</button>

          <div class="pyq-answer">
            <div class="pyq-ans-line"><span class="pyq-ans-label">Answer</span> {qn.answer}</div>
            <div class="pyq-sol">{qn.solution}</div>
          </div>
        </article>
      ))}
    </div>
  </section>
</StudioLayout>

<script>
  import { pyqViewerInit } from '../../scripts/pyq-viewer';
  pyqViewerInit();
</script>

<style>
  .pyq-bar {
    display: flex; justify-content: space-between; align-items: flex-start;
    gap: 16px; flex-wrap: wrap; margin-bottom: 10px;
  }
  .pyq-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .pyq-chip {
    font-family: 'DM Sans', sans-serif; font-weight: 600; font-size: 13px;
    padding: 8px 14px; border-radius: 999px; cursor: pointer;
    background: #eef3f9; color: var(--nine-deep); border: 1.5px solid transparent;
    transition: transform .15s, background .15s, border-color .15s;
  }
  .pyq-chip:hover { transform: translateY(-1px); }
  .pyq-chip.active {
    background: var(--nine-navy); color: #fff; border-color: var(--nine-navy);
  }
  .pyq-allbtn {
    font-family: 'Bricolage Grotesque', sans-serif; font-weight: 600; font-size: 13px;
    padding: 9px 18px; border-radius: 12px; cursor: pointer; white-space: nowrap;
    background: linear-gradient(135deg, var(--nine-accent), #34c4ff); color: #fff;
    border: none; box-shadow: var(--shadow); transition: transform .15s;
  }
  .pyq-allbtn:active { transform: scale(.96); }
  .pyq-count { font-size: 13px; color: #7185a0; font-weight: 600; margin-bottom: 20px; }

  .pyq-list { display: flex; flex-direction: column; gap: 18px; }
  .pyq-card {
    background: #fff; border: 1.5px solid #e4ebf3; border-radius: 18px;
    padding: 22px 24px; box-shadow: var(--shadow);
  }
  .pyq-card.hide { display: none; }
  .pyq-top {
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 12px;
  }
  .pyq-id {
    font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 15px;
    color: #fff; background: var(--nine-navy); padding: 3px 11px; border-radius: 8px;
  }
  .pyq-src { font-size: 12.5px; font-weight: 600; color: var(--nine-accent); }
  .pyq-secname {
    font-size: 11.5px; font-weight: 600; color: #8397ae;
    margin-left: auto; text-align: right;
  }
  .pyq-q {
    font-size: 16px; line-height: 1.6; color: var(--nine-navy);
    font-weight: 500; margin-bottom: 14px;
  }
  .pyq-table {
    border-collapse: collapse; margin: 0 0 14px; width: 100%; max-width: 560px;
    font-size: 14.5px;
  }
  .pyq-table td {
    border: 1px solid #dde6ef; padding: 8px 14px; color: #33475f; font-weight: 500;
  }
  .pyq-table td:first-child { width: 55%; }
  .pyq-opts { list-style: none; display: grid; gap: 7px; margin: 0 0 16px; padding: 0; }
  .pyq-opts li {
    font-size: 15px; color: #33475f; font-weight: 500;
    background: #f5f8fc; border-radius: 10px; padding: 9px 14px;
  }
  .pyq-reveal {
    font-family: 'Bricolage Grotesque', sans-serif; font-weight: 600; font-size: 14px;
    padding: 10px 20px; border-radius: 12px; cursor: pointer;
    background: var(--nine-navy); color: #fff; border: none;
    box-shadow: var(--shadow); transition: transform .15s;
  }
  .pyq-reveal:active { transform: scale(.96); }
  .pyq-answer { display: none; margin-top: 16px; }
  .pyq-card.open .pyq-answer { display: block; animation: fade .3s ease; }
  .pyq-ans-line {
    font-size: 16px; font-weight: 700; color: #16794a;
    background: #e8f7ee; border-radius: 10px; padding: 10px 16px; margin-bottom: 12px;
  }
  .pyq-ans-label {
    font-family: 'Bricolage Grotesque', sans-serif; text-transform: uppercase;
    letter-spacing: 1px; font-size: 12px; color: #16794a; margin-right: 6px;
  }
  .pyq-sol {
    white-space: pre-wrap; font-size: 14.5px; line-height: 1.65; color: #435a72;
    background: #f7fafd; border-left: 3px solid var(--nine-accent);
    border-radius: 0 10px 10px 0; padding: 14px 18px; font-weight: 500;
  }

  @media (max-width: 640px) {
    .pyq-card { padding: 18px 16px; border-radius: 15px; }
    .pyq-secname { width: 100%; margin-left: 0; text-align: left; }
    .pyq-q { font-size: 15px; }
    .pyq-allbtn { width: 100%; }
  }
</style>
