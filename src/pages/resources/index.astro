---
import StudioLayout from '../../layouts/StudioLayout.astro';
import { chapterResources } from '../../data/resources';
---
<StudioLayout title="Nine Education - Physics with Harshith · Notes & Worksheets" chapterChip="Class 11 · Physics">
  <section class="screen active">
    <div class="scr-head">
      <a class="back-btn" href="/" style="text-decoration:none;">‹ Home</a>
      <div>
        <div class="scr-title">Notes & <span class="res-accent">Worksheets</span></div>
        <div class="scr-sub">Chapter notes and practice worksheets - download, print, revise.</div>
      </div>
    </div>

    <div class="res-grid">
      {chapterResources.map((ch) => (
        <div class="res-card">
          <div class="tile-num">{ch.num}</div>
          <h3>{ch.title}<span class="res-accent">{ch.titleAccent}</span></h3>

          {ch.notes ? (
            <a class="res-row" href={ch.notes.url} target="_blank" rel="noopener">
              <span class="res-ic res-ic-notes">
                <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg>
              </span>
              <span class="res-label">{ch.notes.label}</span>
              <span class="res-dl">Download ↓</span>
            </a>
          ) : (
            <div class="res-row res-row-soon">
              <span class="res-ic res-ic-notes" style="opacity:.45;">
                <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
              </span>
              <span class="res-label" style="opacity:.55;">Chapter Notes</span>
              <span class="res-dl" style="opacity:.5;">Coming soon</span>
            </div>
          )}

          {ch.worksheets.length > 0 && (
            <>
              <div class="res-sec">Worksheets</div>
              {ch.worksheets.map((ws) => (
                <a class="res-row" href={ws.url} target="_blank" rel="noopener">
                  <span class="res-ic res-ic-ws">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                  </span>
                  <span class="res-label">{ws.label}</span>
                  <span class="res-dl">Download ↓</span>
                </a>
              ))}
            </>
          )}
        </div>
      ))}
    </div>
  </section>
</StudioLayout>

<style>
  .res-accent{color:var(--nine-accent);}
  .res-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:22px;align-items:start;}
  .res-card{
    background:var(--white);border-radius:24px;padding:28px;
    box-shadow:var(--shadow);position:relative;overflow:hidden;
  }
  .res-card h3{
    font-family:'Bricolage Grotesque';font-weight:800;font-size:26px;
    color:var(--nine-navy);letter-spacing:-.4px;margin-bottom:20px;
  }
  .res-row{
    display:flex;align-items:center;gap:14px;
    padding:13px 16px;border-radius:14px;margin-bottom:10px;
    border:2px solid rgba(41,89,144,.12);text-decoration:none;
    transition:border-color .15s,background .15s,transform .15s;
  }
  a.res-row:hover{border-color:var(--nine-accent);background:#e2f4fd;transform:translateY(-2px);}
  a.res-row:active{transform:scale(.98);}
  .res-row-soon{cursor:default;}
  .res-ic{
    width:40px;height:40px;border-radius:11px;flex-shrink:0;
    display:flex;align-items:center;justify-content:center;
  }
  .res-ic svg{width:22px;height:22px;}
  .res-ic-notes{background:linear-gradient(135deg,var(--nine-dark),var(--nine-deep));}
  .res-ic-ws{background:linear-gradient(135deg,var(--nine-accent),#34c4ff);}
  .res-label{
    flex:1;font-family:'DM Sans';font-weight:700;font-size:16px;color:var(--ink);
  }
  .res-dl{
    font-family:'Bricolage Grotesque';font-weight:600;font-size:13px;
    color:var(--nine-accent);text-transform:uppercase;letter-spacing:1px;white-space:nowrap;
  }
  .res-sec{
    font-family:'Bricolage Grotesque';font-weight:600;font-size:13px;
    text-transform:uppercase;letter-spacing:1.5px;color:var(--nine-deep);
    opacity:.7;margin:18px 0 10px 2px;
  }
  @media (max-width:640px){
    .res-grid{grid-template-columns:1fr;gap:14px;}
    .res-card{padding:20px;border-radius:18px;}
    .res-card h3{font-size:20px;margin-bottom:14px;}
    .res-label{font-size:14px;}
    .res-dl{font-size:11px;}
    .res-ic{width:34px;height:34px;}
    .res-ic svg{width:18px;height:18px;}
  }
</style>
