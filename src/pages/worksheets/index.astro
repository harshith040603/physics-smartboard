---
import StudioLayout from '../../layouts/StudioLayout.astro';
import { chapterResources } from '../../data/resources';
---
<StudioLayout title="Worksheets - Physics with Harshith" chapterChip="Class 11 · Physics">
  <section class="screen active">
    <div class="scr-head">
      <a class="back-btn" href="/" style="text-decoration:none;">‹ Home</a>
      <div>
        <div class="scr-title">Work<span class="res-accent">sheets</span></div>
        <div class="scr-sub">Practice worksheets for every chapter - download, print, solve.</div>
      </div>
    </div>

    <div class="res-grid">
      {chapterResources.map((ch) => (
        <div class="res-card">

          <h3>{ch.title}<span class="res-accent">{ch.titleAccent}</span></h3>

          {ch.worksheets.length > 0 ? (
            ch.worksheets.map((ws) => (
              <a class="res-row" href={ws.url} target="_blank" rel="noopener">
                <span class="res-ic res-ic-ws">
                  <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                </span>
                <span class="res-label">{ws.label}</span>
                <span class="res-dl">Download ↓</span>
              </a>
            ))
          ) : (
            <div class="res-row res-row-soon">
              <span class="res-ic res-ic-ws" style="opacity:.45;">
                <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
              </span>
              <span class="res-label" style="opacity:.55;">Worksheets</span>
              <span class="res-dl" style="opacity:.5;">Coming soon</span>
            </div>
          )}
        </div>
      ))}
    </div>
  </section>
</StudioLayout>
