---
import StudioLayout from '../../layouts/StudioLayout.astro';
import katex from 'katex';
import 'katex/dist/katex.min.css';
import '../../styles/pyq.css';
import '../../styles/assignment.css';
import { META, SECTIONS, MARKING, QUESTIONS } from '../../data/kinematics-practice-set-2';

/* Maths is rendered at build time: split on $...$, KaTeX the maths, escape
   the rest. Only the viewer's filter / reveal wiring ships as script. */
const esc = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

function tex(src: string): string {
  return src.split('$').map((part, i) => (
    i % 2
      ? katex.renderToString(part, { throwOnError: false, displayMode: false })
      : esc(part)
  )).join('');
}

const SEC_NAME: Record<string, string> = Object.fromEntries(
  SECTIONS.map((s) => [s.key, s.name])
);
const countIn = (key: string) => QUESTIONS.filter((q) => q.sec === key).length;
---
<StudioLayout title="Kinematics Practice Set II - Physics with Harshith" chapterChip="Physics · Kinematics">
  <section class="screen active">
    <div class="scr-head">
      <a class="back-btn" href="/kinematics" style="text-decoration:none;">‹ Kinematics</a>
      <div>
        <div class="scr-title">Practice <span class="accent">Set II</span></div>
        <div class="scr-sub">{META.count} JEE Advanced questions. Solve first, then Check answer.</div>
      </div>
    </div>

    <div class="asg-strip">
      <div class="asg-strip-main">
        <div class="asg-strip-title">{META.title} &middot; <b>{META.subject}</b></div>
        <div class="asg-strip-line">{META.line}</div>
        <div class="asg-strip-rule">
          <Fragment set:html={tex(META.rule)} /> Suggested time {META.minutes} minutes.
        </div>
      </div>
      <a class="asg-dl" href={META.pdf} target="_blank" rel="noopener">⬇ Printable PDF</a>
    </div>

    <div class="pyq-bar">
      <div class="pyq-chips">
        <button class="pyq-chip active" data-sec="ALL">All {META.count}</button>
        {SECTIONS.map((sec) => (
          <button class="pyq-chip" data-sec={sec.key}>
            {sec.key} · {sec.name} ({countIn(sec.key)})
          </button>
        ))}
      </div>
      <button id="pyqRevealAll" class="pyq-allbtn">Reveal all answers</button>
    </div>
    <div class="pyq-count"><span id="pyqCount"></span></div>

    <div class="pyq-list">
      {QUESTIONS.map((qn) => (
        <article class="pyq-card" data-sec={qn.sec} data-multi={qn.sec === 'A' ? 'true' : undefined}>
          <div class="pyq-top">
            <span class="pyq-id">Q{qn.id}</span>
            <span class="pyq-src">Section {qn.sec}</span>
            <span class="pyq-secname">{SEC_NAME[qn.sec]}</span>
          </div>

          <p class="pyq-q"><Fragment set:html={tex(qn.q)} /></p>

          {qn.table && (
            <table class="pyq-table">
              <thead>
                <tr><th>Column I</th><th>Column II</th></tr>
              </thead>
              <tbody>
                {Array.from({ length: Math.max(qn.table.left.length, qn.table.right.length) }).map((_, i) => (
                  <tr>
                    <td><Fragment set:html={qn.table!.left[i] ? tex(qn.table!.left[i]) : ''} /></td>
                    <td><Fragment set:html={qn.table!.right[i] ? tex(qn.table!.right[i]) : ''} /></td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}

          {qn.options && (
            <Fragment>
              <div class="pyq-hint">One or more options may be correct - tap every one you want.</div>
              <div class="pyq-opts">
                {qn.options.map((opt) => (
                  <button
                    class="pyq-opt"
                    type="button"
                    data-correct={qn.correct?.some((L) => opt.startsWith(`(${L})`)) ? 'true' : undefined}
                  >
                    <span class="pyq-opt-mark"></span>
                    <span class="pyq-opt-text"><Fragment set:html={tex(opt)} /></span>
                  </button>
                ))}
              </div>
            </Fragment>
          )}

          {qn.sec === 'C' && (
            <div class="pyq-hint">Numerical value - give it to two decimal places.</div>
          )}

          <button class="pyq-reveal">Check answer</button>

          <div class="pyq-answer">
            <div class="pyq-ans-line"><span class="pyq-ans-label">Answer</span> {qn.answer}</div>
            <div class="pyq-sol"><Fragment set:html={tex(qn.solution)} /></div>
          </div>
        </article>
      ))}
    </div>

    <div class="asg-mark">
      <h3>Marking scheme</h3>
      {MARKING.map((m) => (
        <div class="asg-mark-row">
          <span class="asg-mark-sec">{m.sec}</span>
          <span>{m.text}</span>
        </div>
      ))}
    </div>
  </section>
</StudioLayout>

<script>
  import { pyqViewerInit } from '../../scripts/pyq-viewer';
  pyqViewerInit();
</script>
