---
import StudioLayout from '../../layouts/StudioLayout.astro';
---
<StudioLayout title="Kinematics — Smartboard Studio" chapterChip="Physics · Kinematics">

  <!-- =========== HOME =========== -->
  <section id="home" class="screen active">
    <div class="hero">
      <h1>Kine<span class="accent">matics</span></h1>
      <p>Watch motion happen, then take the controls — launch projectiles, read graphs, and race the river.</p>
    </div>
    <div class="grid">

      <div class="tile" onclick="go('projectile')">
        <div class="tile-num">01</div>
        <div class="tile-icon ic-build"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20c4-12 10-16 18-16"/><path d="M17 3l4 1-1 4"/><circle cx="5" cy="19" r="1.6" fill="#fff"/></svg></div>
        <h3>Projectile Playground</h3>
        <p>Set speed, angle and gravity — launch, watch the parabola, and read T, H and R live.</p>
        <span class="tile-go">Start ›</span>
      </div>

      <div class="tile tile-soon">
        <div class="tile-num">02</div>
        <div class="tile-icon ic-sort" style="opacity:.45;"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round"><path d="M3 17l5-6 4 3 6-8"/><path d="M3 21h18"/></svg></div>
        <h3 style="opacity:.55;">Motion Graphs Matcher</h3>
        <p style="opacity:.55;">Match x–t, v–t and a–t graphs to the same motion. Slope and area, made visible.</p>
        <span class="tile-go" style="opacity:.5;">Coming soon</span>
      </div>

      <div class="tile tile-soon">
        <div class="tile-num">03</div>
        <div class="tile-icon ic-vec" style="opacity:.45;"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round"><path d="M4 20c3-2 4-6 3-9 4 2 8 1 10-2"/><path d="M14 5h5v5"/></svg></div>
        <h3 style="opacity:.55;">Distance vs Displacement</h3>
        <p style="opacity:.55;">Draw any path on the grid — watch distance grow while displacement stays a straight arrow.</p>
        <span class="tile-go" style="opacity:.5;">Coming soon</span>
      </div>

      <div class="tile tile-soon">
        <div class="tile-num">04</div>
        <div class="tile-icon ic-conv" style="opacity:.45;"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round"><path d="M2 12h20M6 8c2 2 2 6 0 8M18 8c-2 2-2 6 0 8"/></svg></div>
        <h3 style="opacity:.55;">Relative Motion Lab</h3>
        <p style="opacity:.55;">River-boat crossings and the rain-man umbrella — the same vector triangle, two stories.</p>
        <span class="tile-go" style="opacity:.5;">Coming soon</span>
      </div>

      <div class="tile tile-soon">
        <div class="tile-num">05</div>
        <div class="tile-icon ic-vec" style="opacity:.45;"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round"><path d="M4 20L18 6"/><path d="M12 6h6v6"/><path d="M4 20h9M4 20V11" stroke-dasharray="2 3"/></svg></div>
        <h3 style="opacity:.55;">Vector Resolver</h3>
        <p style="opacity:.55;">Drag a vector and watch its components, magnitude and angle update live.</p>
        <span class="tile-go" style="opacity:.5;">Coming soon</span>
      </div>

      <div class="tile tile-soon">
        <div class="tile-num">06</div>
        <div class="tile-icon ic-grid" style="opacity:.45;"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round"><path d="M12 3v18"/><path d="M8 7h8M7 12h10M6 17h12"/></svg></div>
        <h3 style="opacity:.55;">Free-Fall Visualizer</h3>
        <p style="opacity:.55;">Drop a ball and see the 1 : 3 : 5 odd-number slices appear second by second.</p>
        <span class="tile-go" style="opacity:.5;">Coming soon</span>
      </div>

      <div class="tile tile-soon">
        <div class="tile-num">07</div>
        <div class="tile-icon ic-eqcheck" style="opacity:.45;"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></div>
        <h3 style="opacity:.55;">Equation Selector</h3>
        <p style="opacity:.55;">Read the problem, pick the right equation of motion — before you touch the numbers.</p>
        <span class="tile-go" style="opacity:.5;">Coming soon</span>
      </div>

    </div>
  </section>

  <!-- =========== PROJECTILE PLAYGROUND =========== -->
  <section id="projectile" class="screen">
    <div class="scr-head">
      <button class="back-btn" onclick="go('home')">‹ Back</button>
      <div>
        <div class="scr-title">Projectile Playground</div>
        <div class="scr-sub">Horizontal: constant velocity · Vertical: free fall · The only link is time.</div>
      </div>
    </div>

    <div class="kin-controls">
      <div class="kin-ctrl">
        <label>Speed u <span class="kin-val" id="uVal">25 m/s</span></label>
        <input type="range" id="uSlider" min="5" max="50" step="1" value="25">
      </div>
      <div class="kin-ctrl">
        <label>Angle θ <span class="kin-val" id="thetaVal">45°</span></label>
        <input type="range" id="thetaSlider" min="10" max="80" step="1" value="45">
      </div>
      <div class="kin-ctrl">
        <label>Gravity g <span class="kin-val" id="gVal">10 m/s²</span></label>
        <select id="gSelect">
          <option value="10" selected>Earth (g = 10)</option>
          <option value="9.8">Earth (g = 9.8)</option>
          <option value="1.62">Moon (g = 1.62)</option>
        </select>
      </div>
      <div class="kin-btns">
        <button class="check-btn" id="launchBtn">Launch 🚀</button>
        <button class="btn-reset" id="resetBtn">↺ Reset</button>
      </div>
    </div>

    <div class="kin-canvas" id="projCanvas"></div>

    <div class="kin-stats">
      <div class="kin-stat">
        <div class="kin-stat-name">Time of flight</div>
        <div class="kin-formula" id="fT"></div>
        <div class="kin-stat-val" id="vT">—</div>
      </div>
      <div class="kin-stat">
        <div class="kin-stat-name">Maximum height</div>
        <div class="kin-formula" id="fH"></div>
        <div class="kin-stat-val" id="vH">—</div>
      </div>
      <div class="kin-stat">
        <div class="kin-stat-name">Horizontal range</div>
        <div class="kin-formula" id="fR"></div>
        <div class="kin-stat-val" id="vR">—</div>
      </div>
    </div>
  </section>

</StudioLayout>

<script>
  import '../../scripts/kinematics-studio';
</script>

<style is:global>
  .tile-soon { cursor: default; }
  .tile-soon:hover { transform: none; }

  .kin-controls{
    display:flex;flex-wrap:wrap;gap:22px;align-items:flex-end;
    background:var(--white);border-radius:18px;padding:20px 26px;
    box-shadow:var(--shadow);margin-bottom:20px;
  }
  .kin-ctrl{display:flex;flex-direction:column;gap:8px;min-width:210px;flex:1;}
  .kin-ctrl label{
    font-family:'Bricolage Grotesque';font-weight:700;font-size:16px;color:var(--nine-deep);
    display:flex;justify-content:space-between;align-items:baseline;gap:12px;
  }
  .kin-val{font-family:'DM Sans';font-weight:700;color:var(--nine-accent);font-size:17px;}
  .kin-ctrl input[type=range]{width:100%;accent-color:var(--nine-accent);height:34px;cursor:pointer;}
  .kin-ctrl select{
    font-family:'DM Sans';font-weight:600;font-size:16px;color:var(--ink);
    padding:10px 14px;border-radius:12px;border:2px solid rgba(41,89,144,.25);background:var(--paper-2);
  }
  .kin-btns{display:flex;gap:12px;align-items:center;}

  .kin-canvas{
    background:var(--white);border-radius:18px;box-shadow:var(--shadow);
    overflow:hidden;margin-bottom:20px;min-height:380px;
  }
  .kin-canvas canvas{display:block;}

  .kin-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px;}
  .kin-stat{
    background:var(--white);border-radius:18px;padding:20px 24px;box-shadow:var(--shadow);
    display:flex;flex-direction:column;gap:8px;align-items:flex-start;
  }
  .kin-stat-name{
    font-family:'Bricolage Grotesque';font-weight:700;font-size:15px;letter-spacing:1.4px;
    text-transform:uppercase;color:var(--nine-dark);opacity:.75;
  }
  .kin-formula{font-size:20px;color:var(--nine-navy);min-height:44px;display:flex;align-items:center;}
  .kin-stat-val{
    font-family:'Bricolage Grotesque';font-weight:800;font-size:34px;color:var(--nine-accent);
    letter-spacing:-.5px;
  }
  @media (max-width:640px){
    .kin-controls{padding:16px;gap:14px;}
    .kin-stat-val{font-size:28px;}
  }
</style>
