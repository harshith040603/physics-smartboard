---
import StudioLayout from '../../layouts/StudioLayout.astro';
import { chapterResources, satPapers } from '../../data/resources';
import additions from '../../data/student-library.json';
import slides from '../../data/student-slides.json';

const resources = chapterResources.flatMap(ch => {
  const common = { slug: ch.slug, chapter: ch.title + ch.titleAccent };
  return [
    ...ch.worksheets.map(ws => ({ ...common, kind: 'Assignment', title: ws.label, url: ws.url, detail: 'PDF practice sheet' })),
    ...(ch.notes ? [{ ...common, kind: 'Notes', title: ch.notes.label, url: ch.notes.url, detail: 'PDF study notes' }] : []),
    ...(ch.sheets ?? []).map(sheet => ({ ...common, kind: 'Notes', title: sheet.label, url: sheet.url, detail: 'PDF reference and practice' })),
  ];
});
const all = [...resources, ...slides, ...satPapers.map(p => ({
  slug: 'revision', chapter: 'Revision', kind: 'Assignment', title: p.label, url: p.url, detail: 'PDF test paper',
}))].map(item => ({ ...item, ...additions.find(extra => extra.url === item.url) }));
const unique = [...new Map(all.map(item => [item.url, item])).values()];
const chapters = [...new Map(unique.map(item => [item.slug, item.chapter])).entries()].sort((a, b) => a[1].localeCompare(b[1]));
const kinds = ['Assignment', 'Notes', 'Slides'];
---
<StudioLayout title="Student Library - Physics with Harshith" chapterChip="Student Library">
  <section class="screen active library">
    <div class="hero">
      <span class="library-overline">Class 11 · Study desk</span>
      <h1>Student Library</h1>
      <p>Find the notes, slides and practice sheets for your next study session.</p>
    </div>
    <form class="library-filters" role="search" onsubmit="return false">
      <label>Find a resource<input id="library-search" type="search" placeholder="Try radiation, work, or calorimetry…" /></label>
      <label>Chapter<select id="library-chapter"><option value="">All chapters</option>{chapters.map(([slug, name]) => <option value={slug}>{name}</option>)}</select></label>
      <label>What do you need?<select id="library-kind"><option value="">Everything</option>{kinds.map(kind => <option value={kind}>{kind === 'Assignment' ? 'Assignments' : kind}</option>)}</select></label>
      <button type="reset">Clear filters</button>
    </form>
    <p id="library-count" role="status">{unique.length} resources ready to explore</p>
    <div class="library-grid">
      {unique.map(item => <article class="library-card" data-chapter={item.slug} data-kind={item.kind} data-search={(item.title + ' ' + item.chapter + ' ' + item.kind).toLowerCase()}>
        <div class="library-resource">
          <div class="library-format" aria-hidden="true">
            <svg viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              {item.kind === 'Slides' ? <><rect x="4" y="5" width="20" height="14" rx="2"/><path d="M14 19v4m-5 0h10M8 15l4-4 3 2 4-4"/></> : <><path d="M8 3h8l6 6v16H7V4a1 1 0 0 1 1-1Z"/><path d="M16 3v7h6M11 14h7m-7 4h7"/></>}
            </svg>
          </div>
          <div class="library-summary">
            <div class="library-meta"><span>{item.chapter}</span><span class="library-badge">{item.kind}</span></div>
            <h2>{item.title}</h2>
            <p>{item.detail}</p>
          </div>
        </div>
        <div class="library-actions">
          <a href={item.url} target={item.kind === 'Slides' ? undefined : '_blank'} rel="noopener">{item.kind === 'Slides' ? 'Open slides' : 'Open PDF'} ↗</a>
          {item.kind !== 'Slides' && <a class="download" href={item.url} download>Download ↓</a>}
        </div>
      </article>)}
    </div>
    <p id="library-empty" hidden>No resources match these filters. Try another chapter or clear your search.</p>
  </section>
</StudioLayout>
<script>
  const form = document.querySelector<HTMLFormElement>('.library-filters')!;
  const search = document.querySelector<HTMLInputElement>('#library-search')!;
  const chapter = document.querySelector<HTMLSelectElement>('#library-chapter')!;
  const kind = document.querySelector<HTMLSelectElement>('#library-kind')!;
  const cards = [...document.querySelectorAll<HTMLElement>('.library-card')];
  const params = new URLSearchParams(location.search);
  if ([...chapter.options].some(option => option.value === params.get('chapter'))) chapter.value = params.get('chapter')!;
  function filter() {
    const words = search.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
    let count = 0;
    cards.forEach(card => {
      card.hidden = !!((chapter.value && card.dataset.chapter !== chapter.value) ||
        (kind.value && card.dataset.kind !== kind.value) ||
        !words.every(word => card.dataset.search!.includes(word)));
      if (!card.hidden) count++;
    });
    document.querySelector('#library-count')!.textContent = count + (count === 1 ? ' resource' : ' resources');
    document.querySelector<HTMLElement>('#library-empty')!.hidden = count !== 0;
  }
  form.addEventListener('input', filter);
  form.addEventListener('change', filter);
  form.addEventListener('reset', () => setTimeout(filter, 0));
  filter();
</script>
<style>
  .library-overline {
    color: #425b8b;
    font: 700 .74rem ui-monospace, 'SFMono-Regular', Consolas, monospace;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .library .hero h1 { margin-top: 6px; }
  .library .library-filters {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr) auto;
    align-items: end;
    gap: 14px;
    padding: 16px;
    border: 1px solid #c3cee7;
    border-radius: 12px;
    background: #eef2ff;
  }
  label { display: grid; min-width: 0; gap: 6px; color: #293e6b; font-size: .74rem; font-weight: 750; }
  input, select, button { min-height: 44px; width: 100%; min-width: 0; padding: 9px 10px; border: 1px solid #b6c3e2; border-radius: 7px; background: #fffefa; color: var(--ink); font: inherit; }
  button { cursor: pointer; }
  button:hover { background: #e1e9ff; }
  .library #library-count { margin: 19px 0 11px; color: #3a5384; font-size: .8rem; font-weight: 750; }
  .library .library-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 11px; }
  .library .library-card {
    --format-bg: #e3ecff;
    --format-ink: #2e508d;
    display: flex;
    flex-direction: column;
    padding: 16px 16px 9px;
    border: 1px solid #cdd5e8;
    border-radius: 12px;
    background: #fffefa;
    box-shadow: 0 2px 0 #24365309;
  }
  .library .library-card[hidden] { display: none; }
  .library-card[data-kind="Assignment"] { --format-bg: #fae5c5; --format-ink: #754a26; }
  .library-card[data-kind="Notes"] { --format-bg: #dcf3e9; --format-ink: #275e51; }
  .library-resource { display: flex; gap: 13px; align-items: flex-start; margin-bottom: 12px; }
  .library-format { display: grid; place-items: center; flex: 0 0 46px; height: 46px; border-radius: 9px; background: var(--format-bg); color: var(--format-ink); }
  .library-format svg { width: 26px; height: 26px; }
  .library-summary { min-width: 0; }
  .library .library-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 5px 10px; color: #405a85; font-size: .68rem; font-weight: 700; }
  .library .library-badge { padding: 2px 7px; border-radius: 4px; background: var(--format-bg); color: var(--format-ink); }
  .library .library-card h2 { margin: 5px 0; color: var(--ink); font-size: 1rem; line-height: 1.35; font-weight: 800; letter-spacing: -.035em; overflow-wrap: anywhere; }
  .library-card p { margin: 0; color: #52607b; font-size: .78rem; line-height: 1.5; }
  .library .library-actions { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 6px 12px; margin-top: auto; padding-top: 4px; border-top: 1px solid #e0e4ee; }
  .library .library-actions a { display: inline-flex; align-items: center; min-height: 44px; color: #2d4f86; font-size: .77rem; font-weight: 750; text-underline-offset: 3px; }
  .library-actions .download { text-decoration: none; }
  #library-empty { padding: 24px; border: 1px dashed #b6c3df; border-radius: 10px; background: #fffefa; color: #334f7a; text-align: center; }
  @media (max-width: 760px) {
    .library .library-filters { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .library-filters label:first-child { grid-column: 1 / -1; }
  }
  @media (max-width: 580px) {
    .library .library-grid { grid-template-columns: minmax(0, 1fr); }
    .library .library-filters { padding: 12px; gap: 9px; }
  }
</style>
